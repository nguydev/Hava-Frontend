# -----------------------------------------------------------------------------
# Mr Heat HVAC — environment variables
# Copy this file to `.env` and fill in real values for your environment.
# All client-exposed variables MUST be prefixed with EXPO_PUBLIC_.
# -----------------------------------------------------------------------------

# Base URL of the backend API. Leave blank to use the built-in mock API layer.
EXPO_PUBLIC_API_URL=

# Sentry DSN for crash/error monitoring. Leave blank to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# Toggle the mock API on/off. "true" forces the in-app mock server even when
# EXPO_PUBLIC_API_URL is set. Defaults to true when no API URL is provided.
EXPO_PUBLIC_USE_MOCK_API=true
